<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>br.com.aluguelcarros</groupId>
    <artifactId>aluguel-carros-teste-estrutural</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.jupiter.version>5.11.4</junit.jupiter.version>
        <assertj.version>3.27.6</assertj.version>
        <jacoco.version>0.8.12</jacoco.version>
        <pitest.version>1.17.3</pitest.version>
        <pitest.junit5.version>1.2.1</pitest.junit5.version>
        <python.executable>python3</python.executable>
        <quality.skip>false</quality.skip>
        <pit.threshold>100</pit.threshold>
        <test.group>suite</test.group>
        <experiment.target>legacy</experiment.target>
        <tests.include>**/*Test.java,**/*Teste.java</tests.include>
        <jacoco.check.skip>false</jacoco.check.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <failIfNoTests>true</failIfNoTests>
                    <includes><include>${tests.include}</include></includes>
                    <reportsDirectory>${project.build.directory}/surefire-reports/${test.group}</reportsDirectory>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>aluguel-completa</id>
            <properties>
                <test.group>aluguel-completa</test.group>
                <tests.include>br/com/aluguelcarros/ConjuntoCompleto.java</tests.include>
                <experiment.test>br.com.aluguelcarros.ConjuntoCompleto</experiment.test>
                <experiment.target>br.com.aluguelcarros.CalculadoraCustoLocacao</experiment.target>
                <experiment.classes>br/com/aluguelcarros/CalculadoraCustoLocacao*.class</experiment.classes>
            </properties>
        </profile>
        <profile>
            <id>aluguel-sem-codigo</id>
            <properties>
                <test.group>aluguel-sem-codigo</test.group>
                <tests.include>br/com/aluguelcarros/ConjuntoSemCodigo.java</tests.include>
                <experiment.test>br.com.aluguelcarros.ConjuntoSemCodigo</experiment.test>
                <experiment.target>br.com.aluguelcarros.CalculadoraCustoLocacao</experiment.target>
                <experiment.classes>br/com/aluguelcarros/CalculadoraCustoLocacao*.class</experiment.classes>
            </properties>
        </profile>
        <profile>
            <id>aluguel-sem-especificacao</id>
            <properties>
                <test.group>aluguel-sem-especificacao</test.group>
                <tests.include>br/com/aluguelcarros/ConjuntoSemEspecificacao.java</tests.include>
                <experiment.test>br.com.aluguelcarros.ConjuntoSemEspecificacao</experiment.test>
                <experiment.target>br.com.aluguelcarros.CalculadoraCustoLocacao</experiment.target>
                <experiment.classes>br/com/aluguelcarros/CalculadoraCustoLocacao*.class</experiment.classes>
            </properties>
        </profile>
        <profile>
            <id>aluguel-sem-analise</id>
            <properties>
                <test.group>aluguel-sem-analise</test.group>
                <tests.include>br/com/aluguelcarros/ConjuntoSemAnalise.java</tests.include>
                <experiment.test>br.com.aluguelcarros.ConjuntoSemAnalise</experiment.test>
                <experiment.target>br.com.aluguelcarros.CalculadoraCustoLocacao</experiment.target>
                <experiment.classes>br/com/aluguelcarros/CalculadoraCustoLocacao*.class</experiment.classes>
            </properties>
        </profile>
        <profile>
            <id>poquer-completa</id>
            <properties>
                <test.group>poquer-completa</test.group>
                <tests.include>br/com/poquer/ConjuntoCompleto.java</tests.include>
                <experiment.test>br.com.poquer.ConjuntoCompleto</experiment.test>
                <experiment.target>br.com.poquer.Mao</experiment.target>
                <experiment.classes>br/com/poquer/Mao*.class</experiment.classes>
            </properties>
        </profile>
        <profile>
            <id>poquer-sem-codigo</id>
            <properties>
                <test.group>poquer-sem-codigo</test.group>
                <tests.include>br/com/poquer/ConjuntoSemCodigo.java</tests.include>
                <experiment.test>br.com.poquer.ConjuntoSemCodigo</experiment.test>
                <experiment.target>br.com.poquer.Mao</experiment.target>
                <experiment.classes>br/com/poquer/Mao*.class</experiment.classes>
            </properties>
        </profile>
        <profile>
            <id>poquer-sem-especificacao</id>
            <properties>
                <test.group>poquer-sem-especificacao</test.group>
                <tests.include>br/com/poquer/ConjuntoSemEspecificacao.java</tests.include>
                <experiment.test>br.com.poquer.ConjuntoSemEspecificacao</experiment.test>
                <experiment.target>br.com.poquer.Mao</experiment.target>
                <experiment.classes>br/com/poquer/Mao*.class</experiment.classes>
            </properties>
        </profile>
        <profile>
            <id>poquer-sem-analise</id>
            <properties>
                <test.group>poquer-sem-analise</test.group>
                <tests.include>br/com/poquer/ConjuntoSemAnalise.java</tests.include>
                <experiment.test>br.com.poquer.ConjuntoSemAnalise</experiment.test>
                <experiment.target>br.com.poquer.Mao</experiment.target>
                <experiment.classes>br/com/poquer/Mao*.class</experiment.classes>
            </properties>
        </profile>
        <profile>
            <id>academico-completa</id>
            <properties>
                <test.group>academico-completa</test.group>
                <tests.include>br/com/academico/ConjuntoCompleto.java</tests.include>
                <experiment.test>br.com.academico.ConjuntoCompleto</experiment.test>
                <experiment.target>br.com.academico.ConsolidacaoParcial</experiment.target>
                <experiment.classes>br/com/academico/ConsolidacaoParcial*.class</experiment.classes>
            </properties>
        </profile>
        <profile>
            <id>academico-sem-codigo</id>
            <properties>
                <test.group>academico-sem-codigo</test.group>
                <tests.include>br/com/academico/ConjuntoSemCodigo.java</tests.include>
                <experiment.test>br.com.academico.ConjuntoSemCodigo</experiment.test>
                <experiment.target>br.com.academico.ConsolidacaoParcial</experiment.target>
                <experiment.classes>br/com/academico/ConsolidacaoParcial*.class</experiment.classes>
            </properties>
        </profile>
        <profile>
            <id>academico-sem-especificacao</id>
            <properties>
                <test.group>academico-sem-especificacao</test.group>
                <tests.include>br/com/academico/ConjuntoSemEspecificacao.java</tests.include>
                <experiment.test>br.com.academico.ConjuntoSemEspecificacao</experiment.test>
                <experiment.target>br.com.academico.ConsolidacaoParcial</experiment.target>
                <experiment.classes>br/com/academico/ConsolidacaoParcial*.class</experiment.classes>
            </properties>
        </profile>
        <profile>
            <id>academico-sem-analise</id>
            <properties>
                <test.group>academico-sem-analise</test.group>
                <tests.include>br/com/academico/ConjuntoSemAnalise.java</tests.include>
                <experiment.test>br.com.academico.ConjuntoSemAnalise</experiment.test>
                <experiment.target>br.com.academico.ConsolidacaoParcial</experiment.target>
                <experiment.classes>br/com/academico/ConsolidacaoParcial*.class</experiment.classes>
            </properties>
        </profile>
        <profile>
            <id>medir</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <version>${jacoco.version}</version>
                        <configuration>
                            <includes><include>${experiment.classes}</include></includes>
                            <destFile>${project.build.directory}/jacoco-${test.group}.exec</destFile>
                            <dataFile>${project.build.directory}/jacoco-${test.group}.exec</dataFile>
                            <append>false</append>
                            <outputDirectory>${project.build.directory}/site/jacoco/${test.group}</outputDirectory>
                        </configuration>
                        <executions>
                            <execution>
                                <id>instrumentar-experimento</id>
                                <goals><goal>prepare-agent</goal></goals>
                                <configuration combine.self="override">
                                    <destFile>${project.build.directory}/jacoco-${test.group}.exec</destFile>
                                    <append>false</append>
                                </configuration>
                            </execution>
                            <execution>
                                <id>relatar-experimento</id>
                                <phase>verify</phase>
                                <goals><goal>report</goal></goals>
                                <configuration>
                                    <formats><format>HTML</format><format>XML</format></formats>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>${pitest.version}</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>${pitest.junit5.version}</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <targetClasses><param>${experiment.target}</param></targetClasses>
                            <targetTests><param>${experiment.test}</param></targetTests>
                            <reportsDirectory>${project.build.directory}/pit-reports/${test.group}</reportsDirectory>
                            <mutators><mutator>DEFAULTS</mutator></mutators>
                            <outputFormats><param>HTML</param><param>XML</param></outputFormats>
                            <timestampedReports>false</timestampedReports>
                        </configuration>
                        <executions>
                            <execution>
                                <id>mutar-experimento</id>
                                <phase>verify</phase>
                                <goals><goal>mutationCoverage</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>arestas</id>
            <properties>
                <test.group>arestas</test.group>
                <tests.include>**/CoberturaArestasTeste.java</tests.include>
            </properties>
        </profile>
        <profile>
            <id>mcdc</id>
            <properties>
                <test.group>mcdc</test.group>
                <tests.include>**/McdcTeste.java</tests.include>
                <jacoco.check.skip>true</jacoco.check.skip>
            </properties>
        </profile>
        <profile>
            <id>caminhos</id>
            <properties>
                <test.group>caminhos</test.group>
                <tests.include>**/CaminhosBasicosTeste.java</tests.include>
                <jacoco.check.skip>true</jacoco.check.skip>
            </properties>
        </profile>
        <profile>
            <id>jacoco</id>
            <build><plugins><plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <configuration>
                    <destFile>${project.build.directory}/jacoco-${test.group}.exec</destFile>
                    <dataFile>${project.build.directory}/jacoco-${test.group}.exec</dataFile>
                    <append>false</append>
                    <outputDirectory>${project.build.directory}/site/jacoco/${test.group}</outputDirectory>
                </configuration>
                <executions>
                    <execution><goals><goal>prepare-agent</goal></goals></execution>
                    <execution>
                        <id>report</id><phase>verify</phase>
                        <goals><goal>report</goal></goals>
                        <configuration>
                            <includes><include>br/com/aluguelcarros/*.class</include></includes>
                            <formats><format>HTML</format><format>XML</format></formats>
                        </configuration>
                    </execution>
                    <execution>
                        <id>check-branches</id><phase>verify</phase><goals><goal>check</goal></goals>
                        <configuration>
                            <skip>${jacoco.check.skip}</skip>
                            <rules><rule>
                                <element>CLASS</element>
                                <includes><include>br.com.aluguelcarros.CalculadoraCustoLocacao</include></includes>
                                <limits><limit><counter>BRANCH</counter><value>MISSEDCOUNT</value><maximum>0</maximum></limit></limits>
                            </rule></rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin></plugins></build>
        </profile>
        <profile>
            <id>pitest</id>
            <properties>
                <test.group>suite</test.group>
                <tests.include>**/*Test.java,**/*Teste.java</tests.include>
            </properties>
            <build><plugins>
                <plugin>
                    <groupId>org.pitest</groupId><artifactId>pitest-maven</artifactId>
                    <version>${pitest.version}</version>
                    <dependencies><dependency>
                        <groupId>org.pitest</groupId><artifactId>pitest-junit5-plugin</artifactId>
                        <version>${pitest.junit5.version}</version>
                    </dependency></dependencies>
                    <configuration>
                        <targetClasses><param>br.com.aluguelcarros.CalculadoraCustoLocacao</param></targetClasses>
                        <targetTests><param>br.com.aluguelcarros.*</param></targetTests>
                        <excludedTestClasses><param>br.com.aluguelcarros.Conjunto*</param></excludedTestClasses>
                        <mutators><mutator>DEFAULTS</mutator></mutators>
                        <outputFormats><param>HTML</param><param>XML</param></outputFormats>
                        <timestampedReports>false</timestampedReports>
                        <failWhenNoMutations>true</failWhenNoMutations>
                        <!-- O verificador abaixo exige KILLED, sem contar timeout como morte. -->
                        <mutationThreshold>${pit.threshold}</mutationThreshold>
                    </configuration>
                    <executions><execution>
                        <id>mutation-coverage</id><phase>verify</phase>
                        <goals><goal>mutationCoverage</goal></goals>
                    </execution></executions>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.5.0</version>
                    <executions><execution>
                        <id>check-pit-status</id><phase>verify</phase><goals><goal>exec</goal></goals>
                        <configuration>
                            <skip>${quality.skip}</skip><executable>${python.executable}</executable>
                            <arguments><argument>${project.basedir}/scripts/quality.py</argument><argument>pit</argument></arguments>
                        </configuration>
                    </execution></executions>
                </plugin>
            </plugins></build>
        </profile>
        <profile>
            <id>tsdetect</id>
            <build><plugins><plugin>
                <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.5.0</version>
                <executions><execution>
                    <id>detect-test-smells</id><phase>verify</phase><goals><goal>exec</goal></goals>
                    <configuration>
                        <executable>${python.executable}</executable>
                        <arguments>
                            <argument>${project.basedir}/scripts/quality.py</argument>
                            <argument>tsdetect</argument>
                            <argument>${test.group}</argument>
                            <argument>${tests.include}</argument>
                            <argument>${experiment.target}</argument>
                        </arguments>
                    </configuration>
                </execution></executions>
            </plugin></plugins></build>
        </profile>
    </profiles>
</project>
